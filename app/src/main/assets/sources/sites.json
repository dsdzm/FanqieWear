{
  "version": 1,
  "sites": [
    {
      "key": "biquge365",
      "name": "笔趣阁365",
      "base": "https://www.biquge365.net",
      "note": "免登录 · 已实测",
      "search": {
        "path": "/s.php",
        "method": "POST",
        "body": "type=articlename&s={q}",
        "list": "li:has(a[href^=/book/])",
        "title": "a[href^=/book/]",
        "link": "a[href^=/book/]@href",
        "author": "span"
      },
      "detail": {
        "path": "/{id}/",
        "title": "h1",
        "author": ".xinxi",
        "intro": ".x3",
        "cover": ".zhutu img@src"
      },
      "catalog": {
        "path": "/newbook/{num}/",
        "list": "ul.info a[href^=/chapter/]",
        "link": "@href"
      },
      "chapter": {
        "path": "{itemId}",
        "content": "#txt",
        "remove": [
          "script",
          "style",
          ".ads",
          "div[align=center]"
        ]
      }
    },
    {
      "key": "xbiquge",
      "name": "八一中文",
      "base": "https://www.xbiquge.so",
      "note": "免登录 · 站点结构可能变化",
      "search": {
        "path": "/search.html?s={q}",
        "list": "div.result-item, div.bookbox, li:has(h4 a)",
        "title": "h4 a, h3 a",
        "link": "h4 a@href, h3 a@href",
        "author": "p.author, .author"
      },
      "detail": {
        "path": "/{id}/",
        "title": "h1",
        "author": "#info p:eq(0)",
        "intro": "#intro",
        "cover": "#fmimg img@src"
      },
      "catalog": {
        "path": "/{id}/",
        "list": "#list dd a, .listmain dd a",
        "link": "@href"
      },
      "chapter": {
        "path": "{itemId}",
        "content": "#content, #chaptercontent",
        "remove": [
          "script",
          "style",
          ".bottem",
          "div[align=center]"
        ]
      }
    },
    {
