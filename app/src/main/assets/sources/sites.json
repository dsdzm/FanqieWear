        "link": "h4 a@href, .bookname a@href",
        "author": "p.author, .author"
      },
      "detail": {
        "path": "/{id}/",
        "title": "#info h1, h1",
        "author": "#info p:eq(0)",
        "intro": "#intro",
        "cover": "#fmimg img@src"
      },
      "catalog": {
        "path": "/{id}/",
        "list": "#list dd a, .listmain dd a",
        "link": "@href"
      },
      "chapter": {
        "path": "{itemId}",
        "content": "#content, #booktxt",
        "remove": [
          "script",
          "style",
          "div[align=center]",
          ".bottem"
        ]
      }
    },
